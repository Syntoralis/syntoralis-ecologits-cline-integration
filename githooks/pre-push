#!/bin/sh
# Pre-push: block internal Cline refs and scan pushed commits for secrets
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/cline/*|refs/agents/*)
      echo "ERROR: pushing internal ref '$local_ref' is not allowed." >&2
      exit 1
      ;;
  esac
  node scripts/scan-secrets.js --range "$remote_sha" "$local_sha" || exit 1
done
exit 0
