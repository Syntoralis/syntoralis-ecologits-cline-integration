{
  "name": "syntoralis-ecologits-cline-integration",
  "version": "1.0.0",
  "description": "EcoLogits wrapper for Cline — measures and logs the carbon footprint of every LLM API call",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "patch-cline": "node scripts/apply-patch.js",
    "build-cline": "node scripts/build-cline.js",
    "scan-secrets": "node scripts/scan-secrets.js --staged",
    "install-hooks": "node scripts/install-hooks.js",
    "prepare": "node scripts/install-hooks.js"
  },
  "keywords": [
    "ecologits",
    "cline",
    "llm",
    "carbon-footprint",
    "gwp",
    "adpe",
    "wcf"
  ],
  "author": "Syntoralis",
  "license": "MIT",
  "dependencies": {
    "@ecologits/ecologits.js": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}

